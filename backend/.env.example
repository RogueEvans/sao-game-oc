"""
Archivo de ejemplo para variables de ambiente
Copiar este archivo a .env y llenar con valores reales
"""

# Flask
FLASK_ENV=development
FLASK_DEBUG=True

# Base de Datos
DATABASE_URL=sqlite:///aincrad_game.db

# API
API_HOST=0.0.0.0
API_PORT=5000
API_SECRET_KEY=your-secret-key-here

# Juego
INITIAL_CHARACTER_LEVEL=1
MAX_CHARACTER_LEVEL=100
INITIAL_HP=100
INITIAL_ATK=10
INITIAL_DEF=5
INITIAL_SPD=10
INITIAL_ACC=20
INITIAL_LCK=10

# Pisos
TOTAL_FLOORS=100
ENEMIES_PER_FLOOR=10

# Loot
LOOT_DROP_RATE=0.3
STARTING_INVENTORY_SIZE=20
